@page "/Error"
@using System.Diagnostics

<PageTitle>@L["Erreur"]</PageTitle>

<section class="status-page">
    <div class="container status-page__inner">
        <p class="status-page__code mono">500</p>
        <h1>@L["Une erreur inattendue"] <span class="text-gradient-gold">@L["est survenue"]</span>.</h1>
        <p class="muted">@L["Réessayez dans un instant. Si le problème persiste, contactez-moi."]</p>
        @if (ShowRequestId)
        {
            <p class="mono muted">@L["Référence : {0}", RequestId!]</p>
        }
        <a class="btn btn-gold" href="@SiteLanguage.Home"><Icon Name="arrow-left" Size="16" /> @L["Retour à l'accueil"]</a>
    </div>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
