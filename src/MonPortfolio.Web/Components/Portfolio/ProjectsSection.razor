<section class="section section--alt" id="projects">
    <div class="container">
        <SectionHeading Index="04" Eyebrow="Projets" Title="Des réalisations" Highlight="à fort impact."
                        Subtitle="Fintech, ERP, secteur public, multiplateforme : une sélection de projets menés de la conception à la production." />

        @if (Projects.Count == 0)
        {
            <p class="empty-state">Les projets seront bientôt publiés.</p>
        }
        else
        {
            <div class="filters reveal" role="toolbar" aria-label="Filtrer les projets par catégorie" data-project-filters>
                <button type="button" class="filter is-active" data-filter="*" aria-pressed="true">
                    Tous <span class="filter__count">@Projects.Count</span>
                </button>
                @foreach (var category in categories)
                {
                    <button type="button" class="filter" data-filter="@category.Name" aria-pressed="false">
                        @category.Name <span class="filter__count">@category.Count</span>
                    </button>
                }
            </div>

            <div class="projects-grid">
                @foreach (var (project, index) in Projects.Select((p, i) => (p, i)))
                {
                    <article class="project-card glow-card reveal @(project.IsFeatured ? "is-featured" : null)" data-category="@project.Category">
                        @* Aperçus inclinés : capture écran dans une fenêtre, capture mobile dans un téléphone (devant la
                           fenêtre quand les deux existent) ; sans aucune capture, une fenêtre aux logos de la stack. *@
                        <div class="project-card__cover @CoverModifier(project)" data-variant="@(index % 4)">
                            @if (project.ImageUrl is not null || project.MobileImageUrl is null)
                            {
                                <div class="project-shot">
                                    @if (project.ImageUrl is not null)
                                    {
                                        <img src="@project.ImageUrl" alt="Aperçu de @project.Title" loading="lazy" decoding="async" />
                                    }
                                    else
                                    {
                                        <span class="project-shot__bar" aria-hidden="true">
                                            <span class="code-window__dots"><i></i><i></i><i></i></span>
                                        </span>
                                        <span class="project-shot__screen" aria-hidden="true">
                                            @if (CoverStack(project) is { Count: > 0 } stack)
                                            {
                                                <span class="project-card__stack">
                                                    @foreach (var technology in stack)
                                                    {
                                                        <span class="stack-tile"><TechLogo Name="@technology" Size="30" ShowFallback="false" /></span>
                                                    }
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="project-card__monogram mono">@Monogram(project.Title)</span>
                                            }
                                        </span>
                                    }
                                </div>
                            }
                            @if (project.MobileImageUrl is not null)
                            {
                                <div class="project-phone">
                                    <img src="@project.MobileImageUrl" alt="Aperçu mobile de @project.Title" loading="lazy" decoding="async" />
                                </div>
                            }
                            @if (project.IsFeatured)
                            {
                                <span class="ribbon"><Icon Name="star" Size="13" /> À la une</span>
                            }
                        </div>

                        <div class="project-card__body">
                            <p class="project-card__category">@project.Category</p>
                            <h3>@project.Title</h3>
                            <p class="project-card__summary">@project.Summary</p>

                            @if (project.Description is not null)
                            {
                                <details class="project-card__more">
                                    <summary>En savoir plus</summary>
                                    <p>@project.Description</p>
                                </details>
                            }

                            <ul class="chips" aria-label="Technologies">
                                @foreach (var technology in project.Technologies)
                                {
                                    <TechChip Name="@technology" />
                                }
                            </ul>
                        </div>

                        @if ((project.LiveUrl ?? project.RepositoryUrl) is { } projectUrl)
                        {
                            <footer class="project-card__links">
                                <a class="project-card__cta" href="@projectUrl" target="_blank" rel="noopener noreferrer">
                                    Voir le projet <Icon Name="arrow-right" Size="18" />
                                </a>
                                @if (project.LiveUrl is not null && project.RepositoryUrl is not null)
                                {
                                    <a class="project-card__repo" href="@project.RepositoryUrl" target="_blank" rel="noopener noreferrer"
                                       aria-label="Code source de @project.Title" title="Code source"><Icon Name="github" Size="18" /></a>
                                }
                            </footer>
                        }
                    </article>
                }
            </div>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ProjectDto> Projects { get; set; } = [];

    private List<(string Name, int Count)> categories = [];

    protected override void OnParametersSet() =>
        categories = Projects.GroupBy(p => p.Category).Select(g => (g.Key, g.Count())).ToList();

    private static string? CoverModifier(ProjectDto project) => (project.ImageUrl, project.MobileImageUrl) switch
    {
        (not null, not null) => "project-card__cover--combo",
        (null, not null) => "project-card__cover--phone",
        _ => null
    };

    /// <summary>Jusqu'à trois technologies au logo distinct, pour illustrer la couverture sans image.</summary>
    private static List<string> CoverStack(ProjectDto project) =>
        project.Technologies
            .Select(t => (Name: t, Logo: TechLogos.Resolve(t).FirstOrDefault()))
            .Where(t => t.Logo is not null)
            .DistinctBy(t => t.Logo!.File)
            .Take(3)
            .Select(t => t.Name)
            .ToList();

    private static string Monogram(string title) =>
        string.Concat(title.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Where(w => w.Length > 2 && char.IsLetterOrDigit(w[0]))
            .Take(2)
            .Select(w => char.ToUpperInvariant(w[0])));
}
