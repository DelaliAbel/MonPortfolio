@* Indispensable pour l'indentation du bloc de code (Razor supprime sinon les espaces entre balises). *@
@preservewhitespace true

<section class="section" id="about">
    <div class="container">
        <SectionHeading Index="01" Eyebrow="À propos" Title="La rigueur d'un architecte," Highlight="l'énergie d'un leader." />

        <div class="about-grid">
            <div class="about__text reveal">
                @foreach (var paragraph in Profile.About)
                {
                    <p>@paragraph</p>
                }

                @if (Profile.Languages.Count > 0)
                {
                    <ul class="languages" aria-label="Langues">
                        <li class="languages__label"><Icon Name="globe" Size="15" /> Langues</li>
                        @foreach (var language in Profile.Languages)
                        {
                            <li>
                                <span>@language.Name</span>
                                <span class="level-dots" role="img" aria-label="Niveau @language.Level sur 5">
                                    @for (var i = 1; i <= 5; i++)
                                    {
                                        <i class="@(i <= language.Level ? "on" : null)"></i>
                                    }
                                </span>
                            </li>
                        }
                    </ul>
                }
            </div>

            <figure class="code-window glow-card reveal" aria-label="Extrait de code C# décrivant le profil">
                <div class="code-window__bar">
                    <span class="code-window__dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="mono">Developer.cs</span>
                    <span class="code-window__lang mono">C# 14</span>
                </div>
                <div class="code" translate="no">
                    <span class="line"><span class="tk-attr">[GoldAmbassador</span>(<span class="tk-prop">Since</span> = <span class="tk-num">2026</span>)<span class="tk-attr">]</span></span>
                    <span class="line"><span class="tk-kw">public sealed record</span> <span class="tk-type">Developer</span>(<span class="tk-kw">string</span> <span class="tk-param">Name</span>) : <span class="tk-type">IFullStack</span></span>
                    <span class="line">{</span>
                    <span class="line">    <span class="tk-kw">public string</span> <span class="tk-prop">Role</span> =&gt; <span class="tk-str">"Full-Stack Senior"</span>;</span>
                    <span class="line">    <span class="tk-kw">public string</span>[] <span class="tk-prop">Stack</span> =&gt; [<span class="tk-str">".NET"</span>, <span class="tk-str">"Java"</span>, <span class="tk-str">"Azure"</span>];</span>
                    <span class="line"> </span>
                    <span class="line">    <span class="tk-cm">// Sécurité by design, du domaine jusqu'au cloud.</span></span>
                    <span class="line">    <span class="tk-kw">public</span> <span class="tk-type">Task</span>&lt;<span class="tk-type">Product</span>&gt; <span class="tk-fn">ShipAsync</span>(<span class="tk-type">Idea</span> <span class="tk-param">idea</span>) =&gt;</span>
                    <span class="line">        <span class="tk-type">CleanArchitecture</span>.<span class="tk-fn">From</span>(<span class="tk-param">idea</span>).<span class="tk-fn">DeployAsync</span>();</span>
                    <span class="line">}</span>
                </div>
            </figure>
        </div>

        <div class="expertise-grid">
            @foreach (var expertise in Profile.Expertises)
            {
                <article class="card expertise glow-card reveal">
                    <h3><span class="card-icon"><Icon Name="@expertise.Icon" Size="18" /></span> @expertise.Title</h3>
                    <p>@expertise.Description</p>
                </article>
            }
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public ProfileOptions Profile { get; set; } = default!;
}
