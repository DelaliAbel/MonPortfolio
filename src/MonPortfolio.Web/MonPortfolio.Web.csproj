<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\MonPortfolio.Application\MonPortfolio.Application.csproj" />
    <ProjectReference Include="..\MonPortfolio.Infrastructure\MonPortfolio.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>40ce50cc-9f6e-44a2-a74c-bffb6bb18126</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup Label="Publication (MonsterASP / IIS)">
    <!-- Web Deploy ne pousse ni ne supprime App_Data : les images téléversées sur le serveur sont préservées
         et l'ancienne base SQLite locale n'est jamais publiée. -->
    <ExcludeApp_Data>true</ExcludeApp_Data>
    <!-- Ne jamais effacer sur le serveur les fichiers absents du projet (images, clés, journaux). -->
    <SkipExtraFilesOnServer>true</SkipExtraFilesOnServer>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mot de passe admin et LocalDB de développement : ne partent jamais en production. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
