<!DOCTYPE html>
<html lang="@Languages.Current" data-theme="@theme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#090d16" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@500;600;700;800&display=swap" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["MonPortfolio.Web.styles.css"]" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script type="module" src="@Assets["js/site.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // Le thème est mémorisé dans un cookie (posé par site.js) et rendu côté serveur :
    // pas de flash au chargement, et la navigation améliorée de Blazor ne le réinitialise pas.
    private string theme => HttpContext?.Request.Cookies["theme"] == "light" ? "light" : "dark";
}
